{
  "expo": {
    "name": "Q Hubo Mor POS",
    "slug": "qhubomor-pos-app",
    "version": "1.0.50",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "androidStatusBar": {
      "backgroundColor": "#22C55E"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.qhubomorposapp",
      "versionCode": 51
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite acceder a tus fotos para subir imágenes de los insumos.",
          "cameraPermission": "Permite usar la cámara para tomar fotos a los insumos."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permite usar el micrófono para interactuar con la IA."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3cd2881a-e18d-4489-8ddb-3ca9543872dd"
      }
    },
    "owner": "jhonnierm2"
  }
}
